DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=dev-only-change-me
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
GOOGLE_OAUTH_CLIENT_IDS=
PORT=8001
BEHIND_HTTPS_PROXY=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# Cart sync uses Django Channels on the ASGI server. No extra variable:
# the channel layer is in-memory and does not cross processes.

# Docker Compose (docker compose up -d --build). Local runserver ignores these.
# Compose runs its own Postgres and does not use DATABASE_URL.
# Leave APP_DOMAIN and CERTBOT_EMAIL empty to serve HTTP on port 80.
POSTGRES_DB=reader
POSTGRES_USER=reader
POSTGRES_PASSWORD=
APP_DOMAIN=
CERTBOT_EMAIL=
CERTBOT_STAGING=false
SEED=0
